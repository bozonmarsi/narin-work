      "parameters": {
        "jsCode": "// \"simple: false\" у Gmail Trigger отдаёт сырой формат Gmail API — нет\n// плоских полей from/subject/date, они лежат внутри payload.headers.\n// Достаём их тут один раз и дальше везде используем чистые поля.\nconst headers = ($json.payload && $json.payload.headers) || [];\nfunction h(name) {\n  const found = headers.find(function (x) { return (x.name || '').toLowerCase() === name.toLowerCase(); });\n  return found ? found.value : '';\n}\nconst fromRaw = h('From');\nconst match = fromRaw.match(/<([^>]+)>/);\nconst senderEmail = (match ? match[1] : fromRaw).trim().toLowerCase();\nreturn [{\n  json: {\n    sender_email: senderEmail,\n    subject: h('Subject'),\n    date: h('Date'),\n  },\n  binary: $binary,\n}];"
      },
